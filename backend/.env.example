SUPABASE_URL=https://lgseazfkoqaozavyozno.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_backend_secret
SUPABASE_PROFILE_BUCKET=profile-pictures

# Google OAuth (same Web application client configured in Supabase)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Add this exact URL to the Google OAuth client's Authorized redirect URIs.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/google-calendar/oauth/callback
# Generate with: [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Resend reminder mail configuration (required to enable email reminders)
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Voice assistant (server-side only; never expose this in Vite/frontend variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
